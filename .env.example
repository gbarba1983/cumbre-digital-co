# Copia este archivo como .env y pon tu cadena de conexión de Supabase
# (Project Settings → Database → Connection string → Session pooler).
# No uses la conexión directa db.<ref>.supabase.co: solo funciona por IPv6 y Render no la soporta.
# En Render, define DATABASE_URL en Environment en lugar de usar este archivo.
DATABASE_URL=postgresql://postgres.<ref>:<CONTRASEÑA>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
